#include <stdio.h>
int isprime();

int main(){
	 int n,j;
	 printf("Enter a Number:");
	 scanf("%d",&n);
	 for(j=1;j<=n;j++){
	 	if(j==1){
	 	continue;}
	 	if(isprime(j)<=2)
	 	printf("%d ",j);
	 }
	 return 0;
	 }
	 int isprime(int b){
	 	int i,s=0;
	 	for(i=1;i<=b;i++){
	 	if(b%i==0)
	 	s++;}
	 	return s;
	 }
